# Gemini API Configuration
# GEMINI_API_KEY: Server-side Gemini API key. Configure this in Vercel environment settings.
# If omitted or empty, DealFlow AI runs in Demo Mode with deterministic local mock data.
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: Supported Gemini model identifier (e.g., gemini-3.6-flash, gemini-3.5-flash)
GEMINI_MODEL=gemini-3.6-flash

# AI_MODE: 'live' to enforce Gemini API calls when key is present, 'demo' to force local mock fallback.
AI_MODE=live

# Server Port
PORT=3000
